# Banco de dados local (SQLite) usado pelo schema.prisma
DATABASE_URL="file:./dev.db"

# Configuracoes do Backend NestJS (API)
PORT=3001
JWT_SECRET="segredo_super_seguro_erp_industrial_token_jwt_2026"
