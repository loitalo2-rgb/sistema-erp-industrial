datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. AUTENTICAÇÃO E PERMISSÕES (RBAC)
// ==========================================

enum UserRole {
  ADMIN
  ENGENHARIA
  PCP
  OPERADOR
  COMPRAS
  VENDAS
  FINANCEIRO
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(OPERADOR)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productionLogs ProductionLog[]

  @@map("users")
}

// ==========================================
// 2. CADASTROS BASE (PARCEIROS & ITENS)
// ==========================================

enum PartnerType {
  CLIENTE
  FORNECEDOR
  AMBOS
}

model Partner {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  tradeName   String?
  docNumber   String      @unique // CNPJ ou CPF
  type        PartnerType @default(CLIENTE)
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  saleOrders     SaleOrder[]
  purchaseOrders PurchaseOrder[]
  financials     FinancialTransaction[]

  @@map("partners")
}

enum ItemType {
  MATERIA_PRIMA
  SEMIACABADO
  PRODUTO_ACABADO
  EMBALAGEM
  CONSUMO
}

model Item {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  description    String?
  type           ItemType
  unit           String    // UN, KG, M, L, PC
  costPrice      Decimal   @default(0) @db.Decimal(12, 4)
  salePrice      Decimal   @default(0) @db.Decimal(12, 4)
  minStock       Decimal   @default(0) @db.Decimal(12, 4)
  leadTimeDays   Int       @default(1)
  ncm            String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relacionamentos BOM
  bomParents     BOMItem[]          @relation("ItemBOMChildren")
  boms           BOM[]              @relation("ProductBOM")
  routings       Routing[]
  stockLots      StockLot[]
  stockMovements StockMovement[]
  saleItems      SaleOrderItem[]
  purchaseItems  PurchaseOrderItem[]
  productionOrders ProductionOrder[]

  @@map("items")
}

// ==========================================
// 3. ENGENHARIA & BOM (ESTRUTURA DE PRODUTO)
// ==========================================

model BOM {
  id          String    @id @default(uuid())
  code        String    @unique
  version     String    @default("1.0")
  productId   String
  product     Item      @relation("ProductBOM", fields: [productId], references: [id])
  active      Boolean   @default(true)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items       BOMItem[]

  @@map("boms")
}

model BOMItem {
  id             String   @id @default(uuid())
  bomId          String
  bom            BOM      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentId    String
  component      Item     @relation("ItemBOMChildren", fields: [componentId], references: [id])
  quantity       Decimal  @db.Decimal(12, 4) // Quantidade necessária por unidade
  scrapRate      Decimal  @default(0) @db.Decimal(5, 2) // % de perda técnica esperada
  order          Int      @default(1)

  @@map("bom_items")
}

model WorkCenter {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  capacityPerHour Decimal  @default(1) @db.Decimal(10, 2)
  costPerHour    Decimal  @default(0) @db.Decimal(10, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  routings       Routing[]
  productionLogs ProductionLog[]

  @@map("work_centers")
}

model Routing {
  id             String     @id @default(uuid())
  code           String     @unique
  name           String
  itemId         String
  item           Item       @relation(fields: [itemId], references: [id])
  workCenterId   String
  workCenter     WorkCenter @relation(fields: [workCenterId], references: [id])
  sequence       Int        @default(1)
  setupMinutes   Int        @default(0)
  runTimeMinutes Decimal    @default(0) @db.Decimal(10, 2)
  description    String?

  @@map("routings")
}

// ==========================================
// 4. VENDAS & ORÇAMENTOS
// ==========================================

enum SaleOrderStatus {
  ORCAMENTO
  APROVADO
  EM_PRODUCAO
  FATURADO
  CANCELADO
}

model SaleOrder {
  id             String          @id @default(uuid())
  orderNumber    String          @unique
  partnerId      String
  partner        Partner         @relation(fields: [partnerId], references: [id])
  status         SaleOrderStatus @default(ORCAMENTO)
  totalAmount    Decimal         @default(0) @db.Decimal(12, 2)
  deliveryDate   DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items          SaleOrderItem[]
  productionOrders ProductionOrder[]
  financials     FinancialTransaction[]

  @@map("sale_orders")
}

model SaleOrderItem {
  id          String    @id @default(uuid())
  saleOrderId String
  saleOrder   SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  quantity    Decimal   @db.Decimal(12, 4)
  unitPrice   Decimal   @db.Decimal(12, 2)
  totalPrice  Decimal   @db.Decimal(12, 2)

  @@map("sale_order_items")
}

// ==========================================
// 5. PCP & CHÃO DE FÁBRICA (ORDENS & APONTAMENTOS)
// ==========================================

enum ProductionOrderStatus {
  PLANEJADA
  LIBERADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model ProductionOrder {
  id               String                @id @default(uuid())
  code             String                @unique
  productId        String
  product          Item                  @relation(fields: [productId], references: [id])
  saleOrderId      String?
  saleOrder        SaleOrder?            @relation(fields: [saleOrderId], references: [id])
  quantityPlanned  Decimal               @db.Decimal(12, 4)
  quantityProduced Decimal               @default(0) @db.Decimal(12, 4)
  quantityScrapped Decimal               @default(0) @db.Decimal(12, 4)
  status           ProductionOrderStatus @default(PLANEJADA)
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  logs             ProductionLog[]
  stockMovements   StockMovement[]

  @@map("production_orders")
}

enum ProductionLogType {
  PRODUCAO
  PARADA
  AJUSTE
}

model ProductionLog {
  id                String            @id @default(uuid())
  productionOrderId String
  productionOrder   ProductionOrder   @relation(fields: [productionOrderId], references: [id])
  workCenterId      String
  workCenter        WorkCenter        @relation(fields: [workCenterId], references: [id])
  operatorId        String
  operator          User              @relation(fields: [operatorId], references: [id])
  type              ProductionLogType @default(PRODUCAO)
  startTime         DateTime
  endTime           DateTime?
  quantityGood      Decimal           @default(0) @db.Decimal(12, 4)
  quantityScrapped  Decimal           @default(0) @db.Decimal(12, 4)
  stopReason        String?
  scrapReason       String?
  notes             String?
  createdAt         DateTime          @default(now())

  @@map("production_logs")
}

// ==========================================
// 6. SUPRIMENTOS, COMPRAS & ESTOQUE (FIFO/LOTES)
// ==========================================

model StockLot {
  id           String    @id @default(uuid())
  lotNumber    String
  itemId       String
  item         Item      @relation(fields: [itemId], references: [id])
  quantity     Decimal   @default(0) @db.Decimal(12, 4)
  expirationAt DateTime?
  createdAt    DateTime  @default(now())

  stockMovements StockMovement[]

  @@unique([lotNumber, itemId])
  @@map("stock_lots")
}

enum StockMovementType {
  ENTRADA_COMPRA
  SAIDA_PRODUCAO
  ENTRADA_PRODUCAO
  SAIDA_VENDA
  AJUSTE_INVENTARIO
}

model StockMovement {
  id                String            @id @default(uuid())
  itemId            String
  item              Item              @relation(fields: [itemId], references: [id])
  stockLotId        String?
  stockLot          StockLot?         @relation(fields: [stockLotId], references: [id])
  productionOrderId String?
  productionOrder   ProductionOrder?  @relation(fields: [productionOrderId], references: [id])
  type              StockMovementType
  quantity          Decimal           @db.Decimal(12, 4)
  unitCost          Decimal           @default(0) @db.Decimal(12, 4)
  documentRef       String?           // NF-e ou número da OP
  createdAt         DateTime          @default(now())

  @@map("stock_movements")
}

enum PurchaseOrderStatus {
  COTACAO
  APROVADO
  RECEBIDO
  CANCELADO
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  orderNumber String              @unique
  partnerId   String
  partner     Partner             @relation(fields: [partnerId], references: [id])
  status      PurchaseOrderStatus @default(COTACAO)
  totalAmount Decimal             @default(0) @db.Decimal(12, 2)
  deliveryDate DateTime?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  items       PurchaseOrderItem[]
  financials  FinancialTransaction[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id])
  quantity        Decimal       @db.Decimal(12, 4)
  unitPrice       Decimal       @db.Decimal(12, 2)
  totalPrice      Decimal       @db.Decimal(12, 2)

  @@map("purchase_order_items")
}

// ==========================================
// 7. FINANCEIRO INTEGRADO & DRE GERENCIAL
// ==========================================

enum FinancialType {
  PAGAR
  RECEBER
}

enum FinancialStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

enum DRECategory {
  RECEITA_BRUTA
  DEDUCAO_RECEITA
  CUSTO_PRODUCAO_CPV
  DESPESA_OPERACIONAL
  DESPESA_ADMINISTRATIVA
  OUTRAS_RECEITAS
  OUTRAS_DESPESAS
}

model FinancialTransaction {
  id              String          @id @default(uuid())
  code            String          @unique
  description     String
  type            FinancialType
  status          FinancialStatus @default(PENDENTE)
  dreCategory     DRECategory
  amount          Decimal         @db.Decimal(12, 2)
  paidAmount      Decimal         @default(0) @db.Decimal(12, 2)
  dueDate         DateTime
  paymentDate     DateTime?
  partnerId       String?
  partner         Partner?        @relation(fields: [partnerId], references: [id])
  saleOrderId     String?
  saleOrder       SaleOrder?      @relation(fields: [saleOrderId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  documentRef     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("financial_transactions")
}
